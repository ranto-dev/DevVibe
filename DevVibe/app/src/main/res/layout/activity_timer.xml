<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="#F4F6FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="#2196F3"
            android:padding="20dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:text="DevVibe"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"/>

            <TextView
                android:text="Focus Mode"
                android:textColor="#E0E7FF"
                android:textSize="14sp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"/>
        </LinearLayout>

        <!-- BANNER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_margin="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            android:backgroundTint="#FFFFFF"
            app:cardElevation="4dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/motivationText"
                    android:text="💡 Stay focused. Build your future."
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"/>

                <TextView
                    android:text="Chaque session te rapproche de tes objectifs 🚀"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TASK CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#FFFFFF"
            app:cardElevation="6dp">

            <LinearLayout
                android:padding="20dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/taskTitle"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/taskDescription"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="6dp"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"/>

                <TextView
                    android:id="@+id/taskType"
                    android:textSize="12sp"
                    android:textColor="#2196F3"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TIMER -->
        <TextView
            android:id="@+id/timerText"
            android:text="25:00"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- MESSAGE -->
        <TextView
            android:id="@+id/focusMessage"
            android:text="🚀 Focus en cours..."
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- CONTROLS -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:text="Start"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:backgroundTint="#10B981"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPause"
                android:text="Pause"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="#F59E0B"
                android:textColor="#FFFFFF"
                app:cornerRadius="14dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:text="Reset"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuit"
            android:text="Quitter"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="16dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#EF4444"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"/>

    </LinearLayout>
</ScrollView>